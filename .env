# GhostBrowse 邮件服务配置
# 使用 QQ 邮箱 SMTP 发送验证码邮件

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=937263599@qq.com
SMTP_PASS=gfhvbiiwynmpbbig
SMTP_SECURE=true
SMTP_FROM=GhostBrowse <937263599@qq.com>

# ==================== Ollama AI 配置 ====================
OLLAMA_HOST=http://localhost:11434

# 默认模型：用 yanghao.js 微调的小模型，速度大幅提升
# 你硬件情况：32GB DDR5-7500，AMD 880M 集显（无独显），Ryzen AI 9 H 465（10核20线程）
# 32B 模型把内存吃光（剩 1.3GB），导致频繁 swap 到硬盘，CPU 反而等不到数据
# 改用 qwen3-twitter:latest（约 4~5GB），命令解析 + 评论生成都用它
OLLAMA_MODEL=qwen3-twitter:latest

# 命令解析：可单独指定（默认跟 OLLAMA_MODEL 走）
# 如想保留高质量解析，可设置为 qwen3:32b-q4_K_M（但慢）
# OLLAMA_COMMAND_MODEL=qwen3:32b-q4_K_M

# 评论生成模型
OLLAMA_COMMENT_MODEL=qwen3-twitter:latest

# 单次请求超时（毫秒，小模型 60s 已绰绰有余）
OLLAMA_TIMEOUT_MS=300000

# 命令解析重试次数
AI_COMMAND_RETRIES=3
# 评论生成重试次数
AI_COMMENT_RETRIES=1