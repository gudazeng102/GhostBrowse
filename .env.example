# GhostBrowse 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== 邮件服务配置 ====================
# 使用 QQ 邮箱 SMTP 发送验证码邮件

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-authorization-code
SMTP_SECURE=true
SMTP_FROM=GhostBrowse <your-email@qq.com>

# ==================== Ollama AI 配置 ====================
# Ollama 服务地址（局域网内其他机器也可）
OLLAMA_HOST=http://localhost:11434
# 默认模型（命令解析 + 评论生成共用）
# 推荐配置：命令用 32B 保证准确度，评论用小模型保证速度
OLLAMA_MODEL=qwen3:32b-q4_K_M
# 评论生成模型（小模型保证速度，原 yanghao.js 微调版完全够用）
OLLAMA_COMMENT_MODEL=qwen3-twitter:latest
# 命令解析模型（保持高质量；CPU 推理慢可改成 qwen3-twitter:latest）
# OLLAMA_COMMAND_MODEL=qwen3:32b-q4_K_M
# 单次请求超时（毫秒，32B 思考模型评论生成可能较慢，建议 600000=10分钟）
OLLAMA_TIMEOUT_MS=600000
# 命令解析重试次数
AI_COMMAND_RETRIES=3
# 评论生成重试次数
AI_COMMENT_RETRIES=1
OLLAMA_NUM_THREAD=8

